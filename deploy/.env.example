# aiirisdx-client deployment settings. Copy to deploy/.env and edit. Every AIIRIS_* variable
# below is read by the backend (pydantic Settings, prefix AIIRIS_; JSON for lists/maps) or by
# docker-compose.yml. README.md "Deployment" explains cloud vs on-prem.

# ---------------------------------------------------------------- compose
# which backend to run: gpu (NVIDIA, needs nvidia-container-toolkit) or cpu
COMPOSE_PROFILES=gpu
COMPOSE_PROJECT_NAME=aiirisdx
# host ports (published by nginx / coturn); pick free ones
AIIRIS_HTTP_PORT=8080
AIIRIS_HTTPS_PORT=8443
# backend API directly, bound to 127.0.0.1 only (diagnostics)
AIIRIS_BACKEND_PORT=18000
# host directories mounted into the containers
AIIRIS_WEIGHTS_DIR=./weights
AIIRIS_MEDIA_DIR=./media
AIIRIS_CERTS_DIR=./certs
# nginx server_name (any host if "_")
AIIRIS_SERVER_NAME=_
# GPUs reserved for the backend (profile gpu)
AIIRIS_GPU_COUNT=1
# PyTorch wheel index for the gpu image (cu126 needs NVIDIA driver >= 560)
TORCH_INDEX=https://download.pytorch.org/whl/cu126

# ---------------------------------------------------------------- models / pipeline
# Detector weights inside the container (./weights is mounted at /weights). Leave the line
# commented out (do NOT set it empty) for no detector stage (crop + classifier stub + anatomy).
# AIIRIS_DETECT_WEIGHTS=/weights/detect.pt
# Classifier heads, JSON {"zone": "/weights/zone.pt", ...}; empty = no-op stub
# AIIRIS_CLASSIFY_WEIGHTS={"zone": "/weights/zone.pt"}
# Full pipeline override (JSON list), replaces the default crop/detect/classify/anatomy
# AIIRIS_PIPELINE=[{"name": "crop"}, {"name": "yolo_detect", "params": {"weights": "/weights/det.pt"}}]
AIIRIS_TAXONOMY_VERSION=unversioned
# Inference worker processes (one model copy each) and pool queue (frames, drop-oldest).
# 2 = measured default: an RTX 2070 + 6-core CPU serves 4 streams of 1080p30 with 0 % drops
# (1 worker: 2 streams). See tests/load/README.md; re-measure on the target server.
AIIRIS_WORKERS=2
AIIRIS_QUEUE_SIZE=8
# longer side frames are downscaled to before inference (4K/1080p -> 960)
AIIRIS_MAX_SIDE=960
# dummy frames each worker runs before /health reports ready (CUDA/cuDNN warm-up)
AIIRIS_WARMUP_FRAMES=3

# ---------------------------------------------------------------- sessions / API
# /stop waits this long (s) for in-flight results before closing the log
AIIRIS_DRAIN_TIMEOUT=3.0
# a session with no frames and no API call for this long (s) is closed (log complete=false),
# its WebRTC peer / file released and pruned from memory; 0 = never
AIIRIS_SESSION_IDLE_TIMEOUT=1800
# per-WebSocket results buffer (messages, drop-oldest for a slow client)
AIIRIS_WS_QUEUE_SIZE=64
# Stand token (spec §3): off inside the hospital network; on in the cloud.
AIIRIS_REQUIRE_TOKEN=false
# JSON map stand -> token, e.g. {"stand-1": "<openssl rand -hex 24>"}; the backend refuses to
# start with AIIRIS_REQUIRE_TOKEN=true and an empty map or empty / "change-me" tokens
AIIRIS_STAND_TOKENS={}
# TLS is terminated by nginx (tls.crt + tls.key in AIIRIS_CERTS_DIR). Set true when it is:
# with AIIRIS_REQUIRE_TOKEN=true and AIIRIS_TLS=false the backend warns that tokens travel in
# clear text. With certs mounted, plain HTTP (8080) redirects to HTTPS (8443) except the
# health check; AIIRIS_HTTP_REDIRECT=0 keeps serving plain HTTP too (not with tokens).
AIIRIS_TLS=false
# AIIRIS_HTTP_REDIRECT=1

# ---------------------------------------------------------------- WebRTC / TURN
# Restrict the negotiated codec, e.g. ["video/H264"]; empty = aiortc default
# AIIRIS_VIDEO_CODECS=["video/H264"]
# Static STUN/TURN servers (JSON list of RTCIceServer) for the server and the stands
AIIRIS_ICE_SERVERS=[]
# TURN with time-limited credentials (coturn use-auth-secret). Off by default: empty list.
# To enable: add "turn" to COMPOSE_PROFILES, set the URLs the STANDS and the backend container
# use to reach coturn -- the host's public IP/DNS (cloud) or LAN IP (on-prem), NEVER
# 127.0.0.1/localhost (inside the container that is the container itself: every connection
# then waits ~5 s for the TURN timeout) -- and set both secrets to the same value.
# AIIRIS_TURN_URLS=["turn:203.0.113.10:3478?transport=udp","turn:203.0.113.10:3478?transport=tcp"]
AIIRIS_TURN_URLS=[]
# shared secret; MUST equal TURN_SECRET. Generate: openssl rand -hex 32
# (the backend refuses to start with TURN URLs and an empty / "change-me" secret)
AIIRIS_TURN_SECRET=
# credential lifetime (s); must exceed the longest session (a reconnect gets fresh ones)
AIIRIS_TURN_TTL=7200

# coturn (profile "turn"; docker-compose.yml passes these on its command line)
# TURN_SECRET=<openssl rand -hex 32, same as AIIRIS_TURN_SECRET>
TURN_SECRET=
# address the stands reach this host at (public IP in the cloud, LAN IP on-prem)
TURN_EXTERNAL_IP=
# On-prem only: the address/range the relay may reach despite the private-range denies in
# coturn.conf (normally TURN_EXTERNAL_IP itself). Leave empty in the cloud.
# TURN_ALLOWED_PEER_IP=192.168.10.5
TURN_ALLOWED_PEER_IP=
TURN_REALM=aiirisdx
TURN_PORT=3478
TURN_MIN_PORT=49160
TURN_MAX_PORT=49200
