# syntax=docker/dockerfile:1
# Frontend image: Vite build (node) -> static files served by nginx, which also
# reverse-proxies /api/* (REST + WebSocket) to the backend. Build context: repository root.
#
# Offline build: a warm BuildKit npm cache (RUN --mount=type=cache below) is enough for
# `npm ci --prefer-offline`; for a fully air-gapped site build the images on a connected
# machine and move them with `docker save | docker load` (README "Offline").

FROM node:22-alpine AS build
WORKDIR /src
COPY frontend/package.json frontend/package-lock.json ./
RUN --mount=type=cache,target=/root/.npm npm ci --prefer-offline --no-audit --no-fund
COPY frontend/ ./
RUN npm run build

FROM nginx:1.27-alpine
# templates are rendered by the image's entrypoint (envsubst of ${AIIRIS_*} variables only)
ENV NGINX_ENVSUBST_FILTER=^AIIRIS_ \
    AIIRIS_BACKEND_UPSTREAM=backend:8000 \
    AIIRIS_SERVER_NAME=_
COPY deploy/nginx/default.conf.template /etc/nginx/templates/default.conf.template
COPY deploy/nginx/tls.conf.template /etc/nginx/aiiris/tls.conf.template
COPY deploy/nginx/40-aiiris-tls.sh /docker-entrypoint.d/40-aiiris-tls.sh
COPY deploy/nginx/aiiris-common.conf /etc/nginx/aiiris/common.conf
RUN chmod +x /docker-entrypoint.d/40-aiiris-tls.sh
COPY --from=build /src/dist /usr/share/nginx/html
EXPOSE 8080 8443
HEALTHCHECK --interval=15s --timeout=5s --start-period=10s --retries=3 \
    CMD wget -q -O /dev/null http://127.0.0.1:8080/nginx-health || exit 1
